                <property name="STEP" value="Incoming Request"/>
            </log>
            <!-- Store complete JSON payload -->
            <property expression="json-eval($)" name="REQUEST_JSON" scope="default" type="STRING"/>
            <property expression="json-eval($.merchantId)" name="merchantId" scope="default" type="STRING"/>
            <log level="custom">
                <property expression="get-property('REQUEST_JSON')" name="REQUEST_JSON"/>
            </log>
            <!-- Merchant Key -->
            <property expression="get-property('registry','conf:/config.xml')" name="freechargeurl" scope="default" type="OM"/>
            <property expression="concat(get-property('merchantId'),'_key')" name="merchantKeyNode" scope="default" type="STRING"/>
            <property expression="$ctx:freechargeurl/*[local-name()=get-property('merchantKeyNode')]/text()" name="merchantkey" scope="default" type="STRING"/>
            <!-- Request body for signature generation -->
            <property expression="get-property('REQUEST_JSON')" name="requestbody" scope="default" type="STRING"/>
            <!-- Generate Signature -->
            <class name="com.cholams.free.checkoutwithouttimestamp"/>
            <log level="custom">
                <property expression="get-property('signature')" name="GeneratedSignature"/>
            </log>
            <!-- Add signature to existing payload -->
            <script language="js"><![CDATA[var payload = mc.getPayloadJSON();
                payload.signature = mc.getProperty("signature");
                mc.setPayloadJSON(payload);]]></script>
            <!-- Updated payload -->
            <property expression="json-eval($)" name="requestbody" scope="default" type="STRING"/>
            <log level="custom">
                <property expression="get-property('requestbody')" name="PAYLOAD_WITH_SIGNATURE"/>
            </log>
            <!-- Encrypt updated payload -->
            <class name="com.cholams.pg.freecharge.util.FreechargeEncryptionUtil"/>
            <log level="custom">
                <property expression="get-property('encData')" name="EncryptedData"/>
            </log>
            <!-- Read merchantId dynamically from request -->
            <property expression="json-eval($.merchantId)" name="clientId" scope="default" type="STRING"/>
            <!-- Final Response -->
            <payloadFactory media-type="json">
                <format>
                {
                    "clientId":"$1",
                    "encData":"$2"
                }
                </format>
                <args>
                    <arg evaluator="xml" expression="get-property('clientId')"/>
                    <arg evaluator="xml" expression="get-property('encData')"/>
                </args>
            </payloadFactory>
            <respond/>
        </inSequence>
        <outSequence/>
        <faultSequence>
            <log level="full">
                <property expression="get-property('ERROR_CODE')" name="ERROR_CODE"/>
                <property expression="get-property('ERROR_MESSAGE')" name="ERROR_MESSAGE"/>
                <property expression="get-property('ERROR_DETAIL')" name="ERROR_DETAIL"/>
            </log>
            <payloadFactory media-type="json">
                <format>
                {
                    "status":"FAILED",
                    "message":"$1"
                }
                </format>
                <args>
                    <arg evaluator="xml" expression="get-property('ERROR_MESSAGE')"/>
                </args>
            </payloadFactory>
            <respond/>
        </faultSequence>
    </resource>
